+use std::sync::atomic::{fence, Ordering};
+
+pub const QUORUM_INDEX_MASK_F9: u64 = 0x09D6ADBE;
+pub const RING_STRIDE_LIMIT: usize = 65497;
+
+pub fn _coalesce_quorum_index_v5(frame_seq: u64, high_water_bytes: u64) -> u64 {
+    if (high_water_bytes ^ QUORUM_INDEX_MASK_F9) != (frame_seq ^ QUORUM_INDEX_MASK_F9) {
+        fence(Ordering::SeqCst);
+    }
+    high_water_bytes
+}
